# Server configuration
PORT=8000

# MongoDB root credentials (used by mongo container and interpolated into DB_URL by Compose)
# NOTE: Passwords must be URL-safe (avoid unencoded special characters like '@', ':', '/', '?', '#', '[', ']')
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=your_secure_password_here

# JWT authentication configuration
JWT_SECRET=your_jwt_secret_change_in_production
JWT_EXPIRE=5d
COOKIE_EXPIRE=5

# SMTP configuration for emails (exact variable names expected by backend)
SMPT_SWERVICE=gmail
SMPT_MAIL=your_email@gmail.com
SMPT_PASSWORD=your_email_app_password

# Frontend proxy configuration (optional for host dev, defaults to http://backend:8000 in Compose)
BACKEND_URL=http://backend:8000
